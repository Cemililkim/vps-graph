{
  "apps": {
    "http": {
      "servers": {
        "secrets-must-not-escape": {
          "routes": [
            {
              "match": [{"host": ["example.com"]}],
              "handle": [
                {
                  "handler": "headers",
                  "request": {"set": {"Authorization": ["Bearer super-secret"]}}
                },
                {
                  "handler": "authentication",
                  "providers": {"http_basic": {"accounts": [{"username": "admin", "password": "basic_auth hash"}]}}
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {"dial": "portfolio-web:3000"},
                    {"dial": "{env.CLOUDFLARE_API_TOKEN}"}
                  ],
                  "headers": {"request": {"set": {"X-API_KEY": ["API_KEY=super-secret"]}}}
                }
              ]
            },
            {
              "match": [{"host": ["{env.SECRET_DOMAIN}"]}],
              "handle": [{
                "handler": "reverse_proxy",
                "upstreams": [{"dial": "portfolio-web:3000"}]
              }]
            }
          ],
          "logs": {"credentials": "DATABASE_URL PASSWORD JWT_SECRET CF_API_TOKEN AWS_SECRET_ACCESS_KEY private_key"}
        }
      }
    }
  },
  "storage": {
    "module": "s3",
    "AWS_SECRET_ACCESS_KEY": "super-secret-token"
  },
  "tls": {
    "automation": {
      "policies": [{"issuers": [{"module": "acme", "private_key": "never-return"}]}]
    }
  }
}
